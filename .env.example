# Application
APP_ENV=development

# Authentication (replace JWT_SECRET outside local development)
JWT_SECRET=replace-with-a-random-secret-containing-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=ekip
DEMO_USER_PASSWORD=ekip_demo_password

# PostgreSQL
POSTGRES_DB=ekip
POSTGRES_USER=ekip
POSTGRES_PASSWORD=ekip_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ekip:ekip_local_password@localhost:5432/ekip

# Qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_DOCUMENTS_COLLECTION=ekip_documents

# Document ingestion and RAG
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
RAGAS_LLM_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_ANSWER_TOKENS=600
CHAT_HISTORY_MESSAGE_LIMIT=8
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Browser origins allowed to call FastAPI, comma separated
CORS_ORIGINS=http://localhost:5173

# Vue/Vite
VITE_API_BASE_URL=http://localhost:8000
