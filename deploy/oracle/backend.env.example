# Install as /etc/contextiq/backend.env. Never commit real values.
APP_ENV=production

# Secrets
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?ssl=require
QDRANT_API_KEY=replace-me
OPENAI_API_KEY=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
# Required only when running the demo-user seed command.
DEMO_USER_PASSWORD=replace-me

# External services and browser access
QDRANT_URL=https://replace-me.qdrant.io:6333
QDRANT_DOCUMENTS_COLLECTION=ekip_documents
CORS_ORIGINS=https://contextiq-cyan.vercel.app

# Persistent caches and ingestion temporary files
HF_HOME=/var/lib/contextiq/cache/huggingface
XDG_CACHE_HOME=/var/lib/contextiq/cache
TMPDIR=/var/lib/contextiq/tmp

# Validated model and application tuning (preserve production values)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4.1-mini
RAGAS_LLM_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_SCORE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_ANSWER_TOKENS=600
CHAT_HISTORY_MESSAGE_LIMIT=8
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=800
CHUNK_OVERLAP=120
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_ISSUER=ekip
