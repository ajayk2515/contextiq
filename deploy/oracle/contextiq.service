[Unit]
Description=ContextIQ FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=contextiq
Group=contextiq
WorkingDirectory=/opt/contextiq/current/backend
EnvironmentFile=/etc/contextiq/backend.env
ExecStart=/opt/contextiq/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=contextiq
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/contextiq

[Install]
WantedBy=multi-user.target
